# Python
# Unanchored so these match at any depth — the repo holds several modules,
# each with its own virtualenv (backend/, ...).
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Local data written at runtime (uploaded rasters, temp uploads)
backend/var/

# Captured screenshots and playwright artifacts
/*.png
.playwright-mcp/

# Benchmark results and profiles
web/bench/results/
web/bench/.profiles/

# Editor / OS
.DS_Store
.claude/
