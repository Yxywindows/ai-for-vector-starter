# Copy to .env.local (gitignored) and fill in real values.

# Mapbox access token for the workspace basemap themes (R10).
# Without it the Mapbox themes stay disabled and the project basemap is used.
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Dev server overrides (optional)
# VITE_PORT=1317
# VITE_API_TARGET=http://localhost:1316
